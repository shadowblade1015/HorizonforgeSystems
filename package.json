{
  "name": "ember-solitaire",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node build.mjs",
    "build:native": "node tools/build-native.mjs",
    "native:sync": "npm run build:native && cap sync",
    "native:android": "npm run native:sync && cd android && gradlew.bat assembleDebug",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
